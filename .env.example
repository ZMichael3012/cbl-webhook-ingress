# Local environment variables for cbl-webhook-ingress.
HTTP_ADDR=:8060
METRICS_ADDR=:9260
PG_DSN=postgres://cbl:cbl@localhost:5432/webhook_ingress?sslmode=disable
KAFKA_BROKERS=localhost:9092
WEBHOOK_PROVIDERS={"mock":{"signature_header":"X-Billing-Signature","event_id_header":"X-Event-Id","secret_env":"MOCK_WEBHOOK_SECRET"}}
MOCK_WEBHOOK_SECRET=mock-secret

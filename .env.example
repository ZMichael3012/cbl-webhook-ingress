# Local environment variables for cbl-webhook-ingress.
HTTP_ADDR=:8060
METRICS_ADDR=:9260
PG_DSN=postgres://cbl:cbl@localhost:5432/webhook_ingress?sslmode=disable
KAFKA_BROKERS=localhost:9092
WEBHOOK_PROVIDERS={"mock":{"signature_header":"X-Billing-Signature","event_id_header":"X-Event-Id","secret_env":"MOCK_WEBHOOK_SECRET","rate_rps":1000,"rate_burst":2000}}
MOCK_WEBHOOK_SECRET=mock-secret
WEBHOOK_WRITE_TIMEOUT=450ms
# Dynamic provider allowlist refresh (17.4): default 10m, 0 disables.
WEBHOOK_ALLOWLIST_REFRESH=10m
# Example gateway address allowlist (empty in dev - any addresses are accepted):
# "ip_allowlist":["203.0.113.0/24","2001:db8::/32"]
# Example CF-4 provider strategies (17.4):
# BTCPay raw HMAC:   "verification":{"strategy":"raw_hmac","header":"BTCPay-Sig","prefix":"sha256="},
#                    "event_key":{"header":"BTCPay-Delivery-Id"}
# BitPay raw HMAC:   "verification":{"strategy":"raw_hmac","header":"x-signature","encoding":"base64"},
#                    "event_key":{"template":"{data.id}:{data.status}"},"fetch_required":true,
#                    "gateway_id":{"template":"{data.id}"}
# NOWPayments:       "verification":{"strategy":"canonical_json_hmac","header":"x-nowpayments-sig","algorithm":"sha512"},
#                    "event_key":{"template":"{payment_id}:{payment_status}"},
#                    "gateway_id":{"template":"{payment_id}"}
# CoinGate:          "verification":{"strategy":"token_echo","field":"token"},
#                    "event_key":{"template":"{refund_id}:{refund_status}|{id}:{status}"},
#                    "fetch_required":true,
#                    "ip_allowlist_url":"https://api.coingate.com/v2/ips-v4"
# (CoinGate needs no gateway_id block: the top-level numeric id resolves.)
